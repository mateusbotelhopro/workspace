generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sdr {
  id        String   @id @default(uuid())
  nome      String
  whatsapp  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  leads            Lead[]
  whatsappLogs     WhatsappLog[]
  linkedinAccounts LinkedinAccount[]

  @@map("sdrs")
}

model LinkedinAccount {
  id               String   @id @default(uuid())
  unipileAccountId String   @unique
  accountName      String
  clientName       String?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sdrId          String?
  secondarySdrId String?
  sdr            Sdr?    @relation(fields: [sdrId], references: [id])

  leads Lead[]

  @@map("linkedin_accounts")
}

model Lead {
  id                 String   @id @default(uuid())
  nome               String?
  linkedinProfileUrl String?
  unipileChatId      String?  @unique
  sdrId              String?
  linkedinAccountId  String?
  createdAt          DateTime @default(now())

  sdr             Sdr?             @relation(fields: [sdrId], references: [id])
  linkedinAccount LinkedinAccount? @relation(fields: [linkedinAccountId], references: [id])
  messages        Message[]

  @@map("leads")
}

model Message {
  id               String   @id @default(uuid())
  leadId           String?
  unipileMessageId String   @unique
  texto            String
  direction        String
  receivedAt       DateTime
  createdAt        DateTime @default(now())

  lead         Lead?         @relation(fields: [leadId], references: [id])
  aiAnalysis   AiAnalysis?
  whatsappLogs WhatsappLog[]

  @@map("messages")
}

model AiAnalysis {
  id               String   @id @default(uuid())
  messageId        String   @unique
  resumo           String?
  temperatura      String?
  intencao         String?
  prioridade       String?
  proximoPasso     String?
  respostaSugerida String?
  createdAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id])

  @@map("ai_analysis")
}

model WhatsappLog {
  id         String    @id @default(uuid())
  messageId  String?
  sdrId      String?
  status     String
  error      String?
  retryCount Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  message Message? @relation(fields: [messageId], references: [id])
  sdr     Sdr?     @relation(fields: [sdrId], references: [id])

  @@map("whatsapp_logs")
}
