      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.handoff) staticData.handoff = {};\nconst remoteJid = $('Roteador').item.json.remoteJid;\nconst numero = $('Roteador').item.json.numero;\nconst texto = ($json.textoUsuario || '').toLowerCase();\nlet resposta;\nif (texto.includes('abre campo')) {\n  resposta = 'Boa! Em Abre Campo nosso parceiro pra atendimento odontológico é o *Instituto Felipe Abreu*. Pode chamar direto no WhatsApp: *+55 31 98556-0521* 🦷';\n} else {\n  staticData.handoff[remoteJid] = Date.now() + 30 * 60 * 1000;\n  resposta = 'Entendi! Pra essa cidade eu vou te passar direto pra um dos nossos consultores, só um instante que já te chamam por aqui. 🙂';\n}\nreturn [{ json: { remoteJid, numero, resposta } }];"
