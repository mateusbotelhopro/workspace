    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.handoff) staticData.handoff = {};\nif (!staticData.aguardandoCidade) staticData.aguardandoCidade = {};\n\nconst webhookBody = $('Webhook').item.json.body;\nconst keyObj = webhookBody.data.key;\nconst remoteJid = (keyObj.remoteJid && keyObj.remoteJid.endsWith('@lid') && keyObj.remoteJidAlt) ? keyObj.remoteJidAlt : keyObj.remoteJid;\nconst numero = remoteJid.split('@')[0];\nconst textoOriginal = ($input.item.json.textoUsuario || '').toString();\nconst texto = textoOriginal.toLowerCase().trim();\nconst agora = Date.now();\n\n// 1. Handoff ativo -> bot fica em silêncio por 30 min\nconst handoffAte = staticData.handoff[remoteJid];\nif (handoffAte && agora < handoffAte) {\n  return [{ json: { remoteJid, numero, route: 'pausado' } }];\n}\nif (handoffAte && agora >= handoffAte) {\n  delete staticData.handoff[remoteJid];\n}\n\n// 2. Comando de reset\nconst resetKeywords = ['resetar', 'reset', 'limpar conversa', 'esquecer conversa', 'começar de novo', 'comecar de novo', 'recomeçar', 'recomecar'];\nif (resetKeywords.some(k => texto.includes(k))) {\n  delete staticData.aguardandoCidade[remoteJid];\n  delete staticData.handoff[remoteJid];\n  return [{ json: { remoteJid, numero, route: 'reset' } }];\n}\n\n// 3. Aguardando resposta de cidade (TTL 10 min)\nconst aguardando = staticData.aguardandoCidade[remoteJid];\nif (aguardando && (agora - aguardando.ts) < 10 * 60 * 1000) {\n  delete staticData.aguardandoCidade[remoteJid];\n  return [{ json: { remoteJid, numero, route: 'cidade_resposta', textoUsuario: textoOriginal } }];\n}\nif (aguardando) {\n  delete staticData.aguardandoCidade[remoteJid];\n}\n\n// 4. Palavras-chave (respostas fixas, sem passar pela IA)\nconst grupoTeleconsulta = ['consulta online', 'clinico geral', 'clínico geral', 'pediatra', 'plantao', 'plantão', '24h', '24 horas'];\nconst grupoDentista = ['dentista', 'odonto', 'dental'];\nconst grupoDependentes = ['dependente', 'familiar', 'esposa', 'marido', 'filho', 'filha', 'filhos'];\nconst grupoPsicologa = ['psicolog'];\n\nif (grupoDentista.some(k => texto.includes(k))) {\n  staticData.aguardandoCidade[remoteJid] = { ts: agora };\n  return [{ json: { remoteJid, numero, route: 'dentista_pergunta_cidade' } }];\n}\nif (grupoTeleconsulta.some(k => texto.includes(k))) {\n  return [{ json: { remoteJid, numero, route: 'teleconsulta' } }];\n}\nif (grupoDependentes.some(k => texto.includes(k))) {\n  return [{ json: { remoteJid, numero, route: 'dependentes' } }];\n}\nif (grupoPsicologa.some(k => texto.includes(k))) {\n  return [{ json: { remoteJid, numero, route: 'psicologa' } }];\n}\n\n// 5. Cai na IA (Pedro Paulo)\nreturn [{ json: { remoteJid, numero, route: 'ai', textoUsuario: textoOriginal } }];"
      },
